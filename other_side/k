# ENHANCED PROGRESS TRACKER FOR PLANNING MODE
# ============================================================================

class PlanProgressTracker:
    """Enhanced progress tracker showing plan execution progress and tokens
    
    Displays:
    ██████████░░░░░░░░░ 40% 4/10 · 2s · ↑1234tk
    """
    
    def __init__(self, plan_file: Optional[str] = None):
        self.running = False
        self.thread = None
        self.start_time = None
        self.total_tokens = 0
        self.prompt_tokens = 0
        self.completion_tokens = 0
        self._lock = threading.Lock()
        self.last_line_length = 0
        
        # Plan tracking
        self.plan_file = plan_file
        self.plan = None
        self.completed_subtasks = 0
        self.total_subtasks = 0
        
        # Load initial plan if provided
        if self.plan_file:
            self._load_plan()
    
    def set_plan_file(self, plan_file: str):
        """Set the plan file to track"""
        self.plan_file = plan_file
        self._load_plan()
    
    def _load_plan(self):
        """Load plan and get progress"""
        try:
            if not self.plan_file or not os.path.exists(self.plan_file):
                return
            
            with open(self.plan_file, 'r') as f:
                self.plan = json.load(f)
            
            # Calculate progress
            completed = 0
            total = 0
            
            for task in self.plan.get('tasks', []):
                for subtask in task.get('subtasks', []):
                    total += 1
                    if subtask.get('status') in ['completed', 'done']:
                        completed += 1
            
            with self._lock:
                self.completed_subtasks = completed
                self.total_subtasks = total
        
        except Exception:
            pass
    
    def update_progress(self):
        """Reload plan and update progress"""
        self._load_plan()
    
    def start(self):
        """Start the progress tracker"""
        if not self.running:
            self.running = True
            self.start_time = time.time()
            self.total_tokens = 0
            self.prompt_tokens = 0
            self.completion_tokens = 0
            self.thread = threading.Thread(target=self._update_display, daemon=True)
            self.thread.start()
    
    def update_tokens(self, prompt: int = 0, completion: int = 0):
        """Update token counts"""
        with self._lock:
            self.prompt_tokens += prompt
            self.completion_tokens += completion
            self.total_tokens = self.prompt_tokens + self.completion_tokens
    
    def _format_time(self, seconds: float) -> str:
        """Format elapsed time as Xm Ys or Xs"""
        if seconds < 60:
            return f"{int(seconds)}s"
        else:
            minutes = int(seconds // 60)
            secs = int(seconds % 60)
            return f"{minutes}m {secs}s"
    
    def _update_display(self):
        """Update the progress bar in real-time"""
        while self.running:
            elapsed = time.time() - self.start_time
            time_str = self._format_time(elapsed)
            
            with self._lock:
                tokens = self.total_tokens
                completed = self.completed_subtasks
                total = self.total_subtasks
            
            # Build status line
            if total > 0:
                # Show progress bar
                percentage = (completed / total * 100) if total > 0 else 0
                bar_width = 20
                filled = int(bar_width * completed / total)
                bar = "█" * filled + "░" * (bar_width - filled)
                
                status_line = f"\033[96m{bar}\033[0m \033[93m{percentage:.0f}%\033[0m \033[90m{completed}/{total} · {time_str} · ↑{tokens}tk\033[0m"
            else:
                # No plan loaded, show simple status
                tokens_str = f"↑{tokens}tk" if tokens > 0 else "..."
                status_line = f"\033[90m(esc to interrupt · {time_str} · {tokens_str})\033[0m"
            
            # Clear previous line and write new status
            sys.stdout.write('\r' + ' ' * self.last_line_length + '\r')
            sys.stdout.write(status_line)
            sys.stdout.flush()
            
            # Calculate actual visible length (without ANSI codes)
            visible_status = re.sub(r'\033\[[0-9;]+m', '', status_line)
            self.last_line_length = len(visible_status)
            
            time.sleep(0.5)  # Update every 500ms
    
    def stop(self):
        """Stop the progress tracker"""
        if self.running:
            self.running = False
            if self.thread:
                self.thread.join(timeout=0.5)
            
            # Clear the status line
            sys.stdout.write('\r' + ' ' * self.last_line_length + '\r')
            sys.stdout.flush()
    
    def __enter__(self):
        """Context manager entry"""
        self.start()
        return self
    
    def __exit__(self, exc_type, exc_val, exc_tb):
        """Context manager exit"""
        self.stop()


