class SessionManager:
    """Manages chat history and session state"""

    def __init__(self, session_dir: str = "sessions",
                 log: Optional[Logger] = None):
        # FIX #6: logger passed in — never None at construction time
        self._log = log
        self.session_dir  = Path(session_dir)
        self.session_dir.mkdir(exist_ok=True)
        self.session_id   = datetime.now().strftime("%Y%m%d_%H%M%S")
        self.session_file = self.session_dir / f"session_{self.session_id}.json"
        self.history: List[Dict[str, Any]] = []
        self.load_history()

    def add_message(self, role: str, content: str,
                    metadata: Optional[Dict] = None):
        self.history.append({
            "timestamp": datetime.now().isoformat(),
            "role":      role,
            "content":   content,
            "metadata":  metadata or {}
        })
        self.save_history()

    def save_history(self):
        with open(self.session_file, 'w') as f:
            json.dump(self.history, f, indent=2)

    def load_history(self):
        if self.session_file.exists():
            try:
                with open(self.session_file, 'r') as f:
                    self.history = json.load(f)
            except Exception as e:
                if self._log:
                    self._log.warning(f"Could not load session history: {e}")
                self.history = []

    def get_context(self, limit: int = 5) -> List[Dict]:
        return self.history[-limit:]

    def clear_history(self):
        self.history = []
        self.save_history()


