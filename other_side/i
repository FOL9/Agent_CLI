    def __init__(self, api_key: Optional[str] = None,
                 log: Optional[Logger] = None):
        self.api_key = api_key or os.environ.get("GEMINI_API_KEY")
        if not self.api_key:
            raise ValueError("GEMINI_API_KEY not found in environment variables")

        self.client  = genai.Client(api_key=self.api_key)
        self.ui      = UI()
        self.logger  = log

        # FIX #6: pass logger so SessionManager is never None when it logs
        self.session = SessionManager(log=self.logger)

        self.command_handler = CommandHandler(
            self.session, self.ui.console, self.logger
        )
        self.max_iterations = 20

        # FIX #4: build GenerateContentConfig once — tools don't change
        self._config = self._build_config()

        self.prompt_session = PromptSession(
            completer=merge_completers([CommandCompleter(), FilePathCompleter()]),
            style=autocomplete_style,
            complete_while_typing=True,
            complete_in_thread=True,   # keeps UI responsive
        )

    # ── config ──────────────────────────────────────────────────────────────

    def _build_config(self) -> types.GenerateContentConfig:
        """Build once and reuse."""
        return types.GenerateContentConfig(
            tools=[types.Tool(function_declarations=[
                schema_get_files_info,
                schema_get_file_content,
                schema_run_python_file,
                schema_write_file,
                schema_run_shell,
                schema_build_project,
                schema_install_dependencies,
                schema_patch_file,
                schema_plan_project,
                ALL_CS_SCHEMAS,
            ])],
            system_instruction=self.SYSTEM_PROMPT,
            temperature=0.7,
        )

    # ── request processing ───────────────────────────────────────────────────

    def process_request(self, user_input: str, verbose: bool = False):
        """
        Process user request with AI.

        FIX #2: The message list is seeded from the full session history
        so the model has genuine multi-turn memory.

        FIX #3: ONE StatusTracker per request; pause()/resume() wrap
        tool execution instead of creating new threads each iteration.

        FIX #7: tracker.stop() is idempotent — calling it in both the
        normal path and the except block is safe.
        """
        self.session.add_message("user", user_input)

        # FIX #2: build message history from prior turns
        messages: List[types.Content] = []
        for msg in self.session.history[:-1]:   # exclude current turn
            role = "user" if msg["role"] == "user" else "model"
            messages.append(
                types.Content(role=role,
                              parts=[types.Part(text=msg["content"])])
            )
        messages.append(
            types.Content(role="user",
                          parts=[types.Part(text=user_input)])
        )

        # FIX #3: single tracker for the full request lifecycle
        tracker = StatusTracker()
        tracker.start()

        try:
            for iteration in range(self.max_iterations):

                response = self.client.models.generate_content(
                    model=self.MODEL,
                    contents=messages,
                    config=self._config,   # FIX #4: cached config
                )

                if response is None or response.usage_metadata is None:
                    tracker.stop()
                    self.ui.error("Response Error",
                                  "Response is malformed or empty")
                    if self.logger:
                        self.logger.error("Malformed response from API")
                    return

                tracker.update_tokens(
                    prompt     = response.usage_metadata.prompt_token_count or 0,
                    completion = response.usage_metadata.candidates_token_count or 0,
                )

                if verbose:
                    tracker.pause()
                    self._display_verbose_info(iteration, response)
                    tracker.resume()

                if not response.candidates:
                    continue

                for candidate in response.candidates:
                    if candidate and candidate.content:
                        messages.append(candidate.content)

                if response.function_calls:
                    # FIX #3: pause display while printing tool output
                    tracker.pause()

                    for fc in response.function_calls:
                        result_msg = call_function(fc, verbose)
                        messages.append(result_msg)

                        result_content = ""
                        try:
                            if (result_msg.parts and
                                    result_msg.parts[0].function_response):
                                result_content = (
                                    result_msg.parts[0]
                                    .function_response.response
                                    .get("result", "")
                                )
                        except Exception:
                            pass

                        self.ui.print_tool_execution(
                            fc.name, fc.args, result_content
                        )

                    tracker.resume()   # FIX #3: back to inference display

                else:
                    # Terminal text response
                    tracker.stop()
                    response_text = response.text
                    self.session.add_message("assistant", response_text)
                    self.ui.success("SDX Agent Response", response_text)
                    if self.logger:
                        self.logger.info("Request processed successfully")
                    return

            # for-else: max iterations hit
            tracker.stop()
            self.ui.warning(
                "Max Iterations Reached",
                f"Reached maximum iterations ({self.max_iterations}). "
                "Task may require more steps."
            )
            if self.logger:
                self.logger.warning(
                    f"Max iterations reached for: {user_input[:50]}..."
                )

        except KeyboardInterrupt:
            tracker.stop()   # FIX #7: idempotent
            self.ui.info("Interrupted", "Task interrupted by user")
            if self.logger:
                self.logger.info("Task interrupted by user (Ctrl+C)")

        except Exception as e:
            tracker.stop()   # FIX #7: idempotent
            self.ui.error("Error Processing Request", str(e))
            if self.logger:
                self.logger.error(f"Error processing request: {e}")

    def _display_verbose_info(self, iteration: int, response):
        self.ui.info("Token Usage", (
            f"Iteration: {iteration + 1}/{self.max_iterations}\n"
            f"Prompt tokens: {response.usage_metadata.prompt_token_count}\n"
            f"Candidate tokens: {response.usage_metadata.candidates_token_count}\n"
            f"Total tokens: {response.usage_metadata.total_token_count}"
        ))

    # ── interactive loop ─────────────────────────────────────────────────────

    def run_interactive(self):
        self.ui.welcome_screen()
        if self.logger:
            self.logger.info("SDX Agent started")

        while True:
            try:
                user_input = self.prompt_session.prompt(
                    [('class:prompt', '→ ')],
                    style=PromptStyle.from_dict({'prompt': Theme.GREEN})
                ).strip()

                if not user_input:
                    continue

                if self.command_handler.is_command(user_input):
                    result = self.command_handler.handle(user_input)
                    if result == "EXIT":
                        self.ui.info("Goodbye", "👋 Happy coding! Session saved.")
                        if self.logger:
                            self.logger.info("Agent session ended gracefully")
                        break
                    elif result == "RELOAD":
                        self.ui.info("Reloading", "♻ Restarting SDX Agent...")
                        if self.logger:
                            self.logger.info("Reloading via /reload")
                        os.execv(sys.executable, [sys.executable] + sys.argv)
                    elif result:
                        self.ui.console.print(
                            f"[{Theme.CYAN}]{result}[/{Theme.CYAN}]\n"
                        )
                    continue

                verbose_flag = '--verbose' in user_input
                if verbose_flag:
                    user_input = user_input.replace('--verbose', '').strip()

                self.ui.separator()
                self.process_request(user_input, verbose_flag)
                self.ui.separator()
                self.ui.console.print()

            except KeyboardInterrupt:
                self.ui.info("Interrupted", "Session interrupted. Goodbye! 👋")
                if self.logger:
                    self.logger.info("Session interrupted by user")
                break
            except EOFError:
                self.ui.info("Goodbye", "👋 Happy coding! Session saved.")
                if self.logger:
                    self.logger.info("Session ended (EOF)")
                break
            except Exception as e:
                self.ui.error("Unexpected Error", str(e))
                if self.logger:
                    self.logger.error(
                        f"Unexpected error in interactive loop: {e}",
                        exc_info=True
                    )


