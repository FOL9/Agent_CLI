class CommandCompleter(Completer):
    """Completer for / commands"""

    COMMANDS = [
        'help', 'history', 'clear', 'status',
        'monitor_on', 'monitor_off', 'reload', 'exit', 'quit', 'q'
    ]

    def get_completions(self, document, complete_event):
        word_before_cursor = document.get_word_before_cursor(
            pattern=re.compile(r'/[^\s]*')
        )
        if not word_before_cursor.startswith('/'):
            return
        search_term = word_before_cursor[1:].lower()
        for cmd in self.COMMANDS:
            if search_term in cmd.lower():
                yield Completion(
                    f"/{cmd}",
                    start_position=-len(word_before_cursor),
                    display=f"/{cmd}"
                )


class FilePathCompleter(Completer):
    """
    Completer for @ file paths.

    FIX #1: The original called os.walk('.') on EVERY keystroke, which
    freezes the terminal on large projects. We now build the file list
    once and refresh it lazily in a background thread every 30 seconds.

    FIX #9: The original iterated `files + dirs` then checked
    `entry in dirs` (O(n) per item, and wrong when names overlap).
    Fixed to iterate dirs and files separately.
    """

    IGNORE_DIRS      = {'__pycache__', 'node_modules', 'venv', '.git',
                        '.next', 'dist', 'build', '.mypy_cache', '.pytest_cache'}
    REFRESH_INTERVAL = 30  # seconds

    def __init__(self):
        self._cache: List[str] = []
        self._last_refresh: float = 0.0
        self._lock = threading.Lock()

    def _rebuild(self):
        """Walk the project tree and refresh the internal cache."""
        new_cache: List[str] = []
        for root, dirs, files in os.walk('.'):
            dirs[:] = [
                d for d in dirs
                if not d.startswith('.') and d not in self.IGNORE_DIRS
            ]
            for d in dirs:
                rel = os.path.relpath(os.path.join(root, d), '.')
                new_cache.append(rel + '/')
            for f in files:
                rel = os.path.relpath(os.path.join(root, f), '.')
                new_cache.append(rel)
        with self._lock:
            self._cache = new_cache
            self._last_refresh = time.time()

    def _ensure_fresh(self):
        """Trigger a background refresh if cache is stale."""
        if time.time() - self._last_refresh > self.REFRESH_INTERVAL:
            self._last_refresh = time.time()   # prevent duplicate threads
            threading.Thread(target=self._rebuild, daemon=True).start()

    def get_completions(self, document, complete_event):
        word_before_cursor = document.get_word_before_cursor(
            pattern=re.compile(r'@[^\s]*')
        )
        if not word_before_cursor.startswith('@'):
            return

        self._ensure_fresh()
        search_term = word_before_cursor[1:].lower()

        with self._lock:
            snapshot = list(self._cache)

        for entry in snapshot:
            if search_term in entry.lower():
                yield Completion(
                    f"@{entry}",
                    start_position=-len(word_before_cursor),
                    display=f"@{entry}"
                )


