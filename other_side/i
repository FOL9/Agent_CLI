        self.console.print(f"[{Theme.DIM}]{'─' * width}[/{Theme.DIM}]")

    # ── generic panel helper ────────────────────────────────────────────────

    def _panel(self, content: str, title: str, border: str):
        wrapped = self._wrap_content(content, TerminalUtils.get_width() - 10)
        self.console.print(Panel(
            wrapped, title=title, border_style=border,
            padding=(1, 2), expand=False
        ))

    def success(self, title: str, content: str):
        self._panel(content, f"[{Theme.GREEN}]✓ {title}[/{Theme.GREEN}]", Theme.GREEN)

    def error(self, title: str, content: str):
        self._panel(content, f"[{Theme.RED}]✗ {title}[/{Theme.RED}]", Theme.RED)

    def warning(self, title: str, content: str):
        self._panel(content, f"[{Theme.YELLOW}]⚠ {title}[/{Theme.YELLOW}]", Theme.YELLOW)

    def info(self, title: str, content: str):
        self._panel(content, f"[{Theme.CYAN}]ℹ {title}[/{Theme.CYAN}]", Theme.CYAN)

    def code(self, code: str, language: str = "python"):
        self.console.print(Syntax(
            code, language, theme="monokai",
            line_numbers=not TerminalUtils.is_narrow_terminal(),
            word_wrap=True
        ))

    def _wrap_content(self, content: str, max_width: int) -> str:
        lines = []
        for line in content.split('\n'):
            if len(line) <= max_width:
                lines.append(line)
            else:
                lines.extend(TerminalUtils.wrap_text(line, max_width))
        return '\n'.join(lines)

    def print_tool_execution(self, tool_name: str, args: Dict[str, Any],
                              result: str = None):
        """Print a tool execution log line with 'Green Dot' style"""
        DISPATCH: Dict[str, tuple] = {
            "read_file":            ("Read file",     "file_path"),
            "get_file_content":     ("Read file",     "file_path"),
            "write_file":           ("Update file",   "file_path"),
            "patch_file":           ("Patch file",    "file_path"),
            "run_shell":            ("Run Cmd",       "command"),
            "run_cmd":              ("Run Cmd",       "command"),
            "run_python_file":      ("Run Python",    "file_path"),
            "get_files_info":       ("List files",    "path"),
            "build_project":        ("Build project", "build_tool"),
            "install_dependencies": ("Install deps",  "package_manager"),
        }
        if tool_name in DISPATCH:
            display_name, key = DISPATCH[tool_name]
            default  = "." if key == "path" else ""
            args_str = f'"{args.get(key, default)}"'
        else:
            display_name = tool_name.replace("_", " ").capitalize()
            vals     = list(args.values())
            args_str = f'"{str(vals[0])}"' if vals else '""'

        self.console.print(
            f"[green]●[/green] [bold white]{display_name}[/bold white] "
            f"[yellow]{args_str}[/yellow]"
        )
        if result:
            first_line = str(result).strip().split('\n')[0]
            if len(first_line) > 80:
                first_line = first_line[:77] + "..."
            self.console.print(f"  [dim]└─ {first_line}[/dim]")


