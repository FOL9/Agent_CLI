class ThinkingSpinner:
    """Animated thinking spinner (kept for optional use)"""

    FRAMES = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏']
    COLOR_MAP = {
        Theme.CYAN: '96', Theme.GREEN: '92', Theme.YELLOW: '93',
        Theme.ORANGE: '91', Theme.PURPLE: '95', Theme.BLUE: '94',
    }

    def __init__(self, prefix: str = "⚙  Processing your request",
                 color: str = Theme.YELLOW):
        self.prefix = prefix
        self.color  = color
        self.running = False
        self.thread: Optional[threading.Thread] = None
        self._idx = 0

    def _animate(self):
        while self.running:
            frame  = self.FRAMES[self._idx % len(self.FRAMES)]
            width  = TerminalUtils.get_width()
            prefix = TerminalUtils.truncate_text(self.prefix, width - 10)
            code   = self.COLOR_MAP.get(self.color, '93')
            sys.stdout.write(f'\r\033[{code}m{prefix} {frame}\033[0m')
            sys.stdout.flush()
            self._idx += 1
            time.sleep(0.08)

    def start(self):
        if not self.running:
            self.running = True
            self.thread  = threading.Thread(target=self._animate, daemon=True)
            self.thread.start()

    def stop(self, success_msg: Optional[str] = None):
        if self.running:
            self.running = False
            if self.thread:
                self.thread.join(timeout=0.2)
            width = TerminalUtils.get_width()
            if success_msg:
                msg = TerminalUtils.truncate_text(success_msg, width - 5)
                sys.stdout.write(f'\r\033[92m✔\033[0m {msg}\n')
            else:
                sys.stdout.write('\r\033[92m✔\033[0m Done!       \n')
            sys.stdout.flush()

    def __enter__(self):
        self.start(); return self

    def __exit__(self, exc_type, *_):
        if exc_type:
            sys.stdout.write('\r\033[91m✗\033[0m Failed!     \n')
            sys.stdout.flush()
        else:
            self.stop()


